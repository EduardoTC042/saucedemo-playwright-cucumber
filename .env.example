# Variables opcionales (exportarlas en la terminal o usar cross-env)
BASE_URL=https://www.saucedemo.com
BROWSER=chromium        # chromium | firefox | webkit
HEADLESS=true           # false para ver el navegador
SLOW_MO=0               # ms de pausa entre acciones (debug)
DEFAULT_TIMEOUT=15000   # timeout por acción/espera en ms
PARALLEL=2              # workers de Cucumber
RETRY=0                 # reintentos de escenarios fallidos
